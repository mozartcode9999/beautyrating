{
  "expo": {
    "name": "BeautyRate",
    "slug": "beautyrate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#667eea"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourcompany.beautyrate",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Nous avons besoin d'accéder à vos photos pour que vous puissiez télécharger vos selfies.",
        "NSCameraUsageDescription": "Nous avons besoin d'accéder à votre caméra pour prendre des selfies."
      }
    },
    "android": {
      "package": "com.yourcompany.beautyrate",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#667eea"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "L'app accède à vos photos pour télécharger vos selfies.",
          "cameraPermission": "L'app utilise la caméra pour prendre des selfies."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
